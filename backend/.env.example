# Copy to .env and fill in for local development.

SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:4200

# SimpleJWT lifetimes, in minutes/hours.
ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_HOURS=24

# Only read by config.settings.prod — sqlite is used automatically in dev.
DATABASE_URL=postgres://hms:hms@localhost:5432/hms
DATABASE_SSL_REQUIRE=True
SECURE_SSL_REDIRECT=True
